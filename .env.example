# ---- LLM / AI ----
# Claude API key (used by the FastAPI backend for content generation & SEO agents)
ANTHROPIC_API_KEY=

# ---- SEO data providers ----
AHREFS_API_KEY=
SE_RANKING_API_KEY=

# Google Search Console (service account JSON path or OAuth client)
GSC_CREDENTIALS_PATH=

# ---- Backend ----
# Comma-separated list of allowed CORS origins for the FastAPI app
API_CORS_ORIGINS=http://localhost:3000
API_ENV=development

# ---- Frontend ----
# Base URL the Next.js app uses to reach the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
